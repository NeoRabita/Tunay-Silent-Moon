{
  "Logging": {
    "LogLevel": {
      "SilentMoonApp.Infrastructure.Authentication": "Debug",
      "SilentMoonApp.Infrastructure.Caching": "Debug",
      "SilentMoonApp.Application.Behaviours.LoggingBehaviour": "Debug"
    },

    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": false,
        "SingleLine" : false,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "ColorBehavior": "Default"
      }
    }
  }
}
